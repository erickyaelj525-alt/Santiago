# ---------------------------------------------------------------------
# Apiario Digital - Variables de entorno del backend
# Copia este archivo como ".env" y ajusta los valores.
# ---------------------------------------------------------------------

# Puerto del servidor Express
PORT=4000

# Conexión a MySQL / MariaDB (XAMPP por defecto: root sin contraseña)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=apiario_digital

# Clave secreta para firmar los JWT (cámbiala en producción)
JWT_SECRET=cambia_esta_clave_por_una_larga_y_aleatoria
JWT_EXPIRES=8h

# Origen permitido para CORS (el dev server de Vite)
CLIENT_URL=http://localhost:5173

# ---------------------------------------------------------------------
# Correo (SMTP) para enviar el código de verificación de cuenta.
# Si se dejan vacíos, la app funciona en MODO DEMO: el código se muestra
# en la consola del servidor y en la pantalla de verificación.
#
# Para Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465 y SMTP_PASS debe ser
# una "contraseña de aplicación" (16 letras) generada en tu cuenta Google
# (Cuenta de Google > Seguridad > Contraseñas de aplicaciones).
# ---------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
